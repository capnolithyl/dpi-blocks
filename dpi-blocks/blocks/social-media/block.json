{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "dpi/social-media",
	"version": "1.1.0",
	"title": "Social Media",
	"category": "dpi-blocks",
	"icon": "share",
	"description": "Displays social profiles and an optional shortcode-powered social feed.",
	"keywords": ["social", "profiles", "feed", "instagram"],
	"textdomain": "dpi-blocks",
	"acf": {"mode": "preview", "renderCallback": "dpi_blocks_render_acf_block", "blockVersion": 3},
	"supports": {
		"anchor": true,
		"align": ["wide", "full"],
		"color": {"background": true, "text": true, "link": true, "gradients": true},
		"spacing": {"margin": true, "padding": true, "blockGap": true},
		"typography": {"fontSize": true, "lineHeight": true},
		"dimensions": {"minHeight": true},
		"html": false
	}
}
