{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "dpi/mass-times",
	"version": "1.1.0",
	"title": "Mass Times",
	"category": "dpi-blocks",
	"icon": "clock",
	"description": "Presents grouped liturgy schedules, notes, media, and related links.",
	"keywords": ["mass", "schedule", "times", "liturgy"],
	"textdomain": "dpi-blocks",
	"acf": {"mode": "preview", "renderCallback": "dpi_blocks_render_acf_block", "blockVersion": 3},
	"supports": {
		"anchor": true,
		"align": ["wide", "full"],
		"color": {"background": true, "text": true, "link": true, "gradients": true},
		"spacing": {"margin": true, "padding": true, "blockGap": true},
		"typography": {"fontSize": true, "lineHeight": true},
		"dimensions": {"minHeight": true},
		"html": false
	}
}
