{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "dpi/staff-card",
	"version": "1.1.0",
	"title": "Staff Card",
	"category": "dpi-blocks",
	"icon": "businessperson",
	"description": "Displays a selected staff member with configurable contact and biography behavior.",
	"keywords": ["staff", "person", "directory", "profile"],
	"textdomain": "dpi-blocks",
	"acf": {"mode": "preview", "renderCallback": "dpi_blocks_render_acf_block", "blockVersion": 3},
	"supports": {
		"anchor": true,
		"align": ["wide", "full"],
		"color": {"background": true, "text": true, "link": true, "gradients": true},
		"spacing": {"margin": true, "padding": true, "blockGap": true},
		"typography": {"fontSize": true, "lineHeight": true},
		"dimensions": {"minHeight": true},
		"html": false
	}
}
