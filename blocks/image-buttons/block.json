{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "dpi/image-buttons",
  "version": "1.2.0",
  "title": "Image Buttons",
  "category": "dpi-blocks",
  "icon": "format-gallery",
  "description": "Linked image cards with overlay or captioned text, including an optional hover/focus reveal state.",
  "keywords": [
    "images",
    "cards",
    "links"
  ],
  "textdomain": "dpi-blocks",
  "acf": {
    "mode": "preview",
    "renderCallback": "dpi_blocks_render_acf_block",
    "blockVersion": 3
  },
  "supports": {
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "color": {
      "background": true,
      "text": true,
      "link": true,
      "gradients": true
    },
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    },
    "dimensions": {
      "minHeight": true
    },
    "html": false
  }
}
