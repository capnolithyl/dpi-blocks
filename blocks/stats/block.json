{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "dpi/stats",
	"version": "1.4.0",
	"title": "Stats",
	"category": "dpi-blocks",
	"icon": "chart-pie",
	"description": "Displays a concise collection of statistics in a row or cards.",
	"keywords": ["statistics", "numbers", "facts"],
	"textdomain": "dpi-blocks",
	"acf": {"mode": "preview", "renderCallback": "dpi_blocks_render_acf_block", "blockVersion": 3},
	"supports": {
		"anchor": true,
		"align": ["wide", "full"],
		"color": {"background": true, "text": true, "link": true, "gradients": true},
		"spacing": {"margin": true, "padding": true, "blockGap": true},
		"typography": {"fontSize": true, "lineHeight": true},
		"dimensions": {"minHeight": true},
		"html": false
	}
}
