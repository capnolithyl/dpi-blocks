{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "dpi/accordion",
  "version": "1.0.0",
  "title": "Accordion / FAQ",
  "category": "dpi-blocks",
  "icon": "editor-help",
  "description": "Accessible accordion for FAQs and other question-and-answer content.",
  "keywords": ["accordion", "faq", "questions", "answers"],
  "textdomain": "dpi-blocks",
  "acf": {"mode": "preview", "renderCallback": "dpi_blocks_render_acf_block", "blockVersion": 3},
  "supports": {
    "anchor": true,
    "align": ["wide", "full"],
    "color": {"background": true, "text": true, "link": true},
    "spacing": {"margin": true, "padding": true},
    "html": false
  },
  "style": "file:./style.css",
  "script": "file:./view.js"
}
